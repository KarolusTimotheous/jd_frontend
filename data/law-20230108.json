{
  "law": {
    "id": "20230108",
    "parentId": "00000000",
    "rank": 12,
    "name": "범죄수익은닉규제법",
    "issue": "투자사기 피해금 돈 세탁",
    "summary": "투자사기 피해금 돈 세탁 이슈는 주식 투자사기 조직이 피해자들로부터 가로챈 돈을 카지노를 이용해 현금화한 사건입니다. 해당 조직은 가짜 투자 사이트를 통해 약 20억5천만 원을 편취한 뒤, 이를 카지노에서 게임 칩으로 바꿨다가 다시 현금으로 환전하는 방식으로 범죄수익을 세탁했습니다. 법원은 인출책 모집 등 범죄수익 세탁에 가담한 A 씨에게 사기 및 범죄수익은닉규제법 위반 혐의로 징역 1년 8개월과 추징금 380만 원을 선고했습니다.",
    "updated": "2026-10-04",
    "sourceUrl": "https://argos.nanet.go.kr/main/fusionanalysis/lawIssueGuest.do?lawKwdId=20230108&lawKwdPid=00000000&titleNm=%EB%B2%94%EC%A3%84%EC%88%98%EC%9D%B5%EC%9D%80%EB%8B%89%EA%B7%9C%EC%A0%9C%EB%B2%95"
  },
