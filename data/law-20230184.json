{
  "law": {
    "id": "20230184",
    "parentId": "00000000",
    "rank": 16,
    "name": "산업기술보호법",
    "issue": "국가핵심기술 유출",
    "summary": "산업기술보호법과 관련한 국가핵심기술 유출 이슈는 반도체 분야의 국가핵심기술과 영업비밀이 인력 이동, 협력사, 장비·소재 공급망 등을 통해 해외로 유출될 위험이 커지고 있다는 점입니다. 실제로 D램 공정기술을 중국 업체에 넘기거나 국내 반도체 공장의 설계·운용 노하우를 외국 공장 건설에 적용 한 사례, 반도체 장비 기술을 부정하게 취득해 중국으로 수출한 사례 등이 적발됐습니다. 특히 반도체 기술은 설계도나 공정자료뿐 아니라 엔지니어에게 축적된 노하우까지 포함돼 있어 위반행위에 대한 처벌을 강화하는 한편, 공급망 전반의 기술보호 체계를 촘촘히 구축할 필요성이 커지고 있습니다.",
    "updated": "2026-10-03",
    "sourceUrl": "https://argos.nanet.go.kr/main/fusionanalysis/lawIssueGuest.do?lawKwdId=20230184&lawKwdPid=00000000&titleNm=%EC%82%B0%EC%97%85%EA%B8%B0%EC%88%A0%EB%B3%B4%ED%98%B8%EB%B2%95"
  },
