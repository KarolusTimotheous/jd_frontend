{
  "law": {
    "id": "20230027",
    "parentId": "00000000",
    "rank": 18,
    "name": "공정거래법",
    "issue": "16조원대 석유화학제품 담합",
    "summary": "16조원대 석유화학제품 담합 이슈는 7개 석유화학사가 약 5년 동안 폴리염화비닐(PVC), 가소제 등 8개 품목의 공급가격과 입찰가격 등을 서로 합의해 경쟁을 제한한 사건입니다. 담합 규모는 약 16조3961억 원에 달하며, 검찰은 원재료 비용 등이 제품 가격에 반영돼 소비자에게 피해를 전가했다고 보고 있습니다. 이와 관련해 석유화학사 6곳과 임직원 37명이 공정거래법 위반 혐의로 재판에 넘겨졌습니다.",
    "updated": "2026-10-02",
    "sourceUrl": "https://argos.nanet.go.kr/main/fusionanalysis/lawIssueGuest.do?lawKwdId=20230027&lawKwdPid=00000000&titleNm=%EA%B3%B5%EC%A0%95%EA%B1%B0%EB%9E%98%EB%B2%95"
  },
