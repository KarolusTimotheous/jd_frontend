{
  "law": {
    "id": "20230007",
    "parentId": "00000000",
    "rank": 1,
    "name": "마약류관리법",
    "issue": "마약 매매 유죄",
    "summary": "마약류관리법은 마약류의 불법 매매 등 위반 행위에 대한 처벌을 규정하고 있습니다. 이와 관련한 마약 매매 유죄 이슈는 필로폰을 판매한 후 구매자의 요구로 대금을 즉시 환불했더라도 마약류 매매죄가 성립한다는 대법원의 판단입니다. 대법원은 매매가 이미 성립한 이상 환불 여부와 관계없이 처벌할 수 있다고 판단해 판매자에게 징역 2년 6개월과 추징금 50만 원을 확정했습니다.",
    "updated": "2026-10-07",
    "sourceUrl": "https://argos.nanet.go.kr/main/fusionanalysis/lawIssueGuest.do?lawKwdId=20230007&lawKwdPid=00000000&titleNm=%EB%A7%88%EC%95%BD%EB%A5%98%EA%B4%80%EB%A6%AC%EB%B2%95"
