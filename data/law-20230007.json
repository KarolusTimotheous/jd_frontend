      "proposer": "보건복지위원장",
      "status": "공포",
      "date": "2026-03-30",
      "url": "https://likms.assembly.go.kr/bill/billDetail.do?billId=PRC_A2B6N0T3A1W2N2F0Z2G7P1A3R1B0K5"
