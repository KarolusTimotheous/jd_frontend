{
  "law": {
    "id": "20241203",
    "parentId": "00000000",
    "rank": 4,
    "name": "정보통신망법",
    "issue": "금융기관 해킹",
    "summary": "정보통신망법은 정당한 접근권한 없이 정보통신망에 침입하거나 운영을 방해하는 행위 등을 금지하고 있습니다. 이와 관련한 금융기관 해킹 이슈는 신한은행, KB국민은행, 하나은행 등 국내 주요 금융기관의 정보통신망을 대상으로 해킹 공격이 잇따라 발생한 사건입니다. 해커들은 은행의 업무지원 시스템과 대출 관련 서비스 등 외부에 노출된 시스템의 보안 취약점을 공략한 것으로 알려졌으며,인공지능이 활용된 정황도 제기됐습니다.",
    "updated": "2026-10-07",
    "sourceUrl": "https://argos.nanet.go.kr/main/fusionanalysis/lawIssueGuest.do?lawKwdId=20241203&lawKwdPid=00000000&titleNm=%EC%A0%95%EB%B3%B4%ED%86%B5%EC%8B%A0%EB%A7%9D%EB%B2%95"
  },
