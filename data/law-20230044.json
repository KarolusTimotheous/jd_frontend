{
  "law": {
    "id": "20230044",
    "parentId": "00000000",
    "rank": 2,
    "name": "전자금융거래법",
    "issue": "금융기관 해킹",
    "summary": "전자금융거래법은 전자금융거래의 신뢰성을 위해 금융회사의 정보기술 안전성 확보 등을 규정하고 있습니다. 이와 관련한 금융기관 해킹 이슈는 신한은행, KB국민은행, 하나은행 등 국내 금융기관을 대상으로 해킹 공격이 잇따라 발생한 사건입니다. 이번 공격은 은행의 핵심 금융거래 시스템뿐 아니라 직원용 업무지원 시스템과 대출 관련 서비스 등 외부에 노출된 시스템을 대상으로 이루어졌으며, 인공지능이 활용된 정황도 제기됐습니다.",
    "updated": "2026-10-07",
    "sourceUrl": "https://argos.nanet.go.kr/main/fusionanalysis/lawIssueGuest.do?lawKwdId=20230044&lawKwdPid=00000000&titleNm=%EC%A0%84%EC%9E%90%EA%B8%88%EC%9C%B5%EA%B1%B0%EB%9E%98%EB%B2%95"
  },
