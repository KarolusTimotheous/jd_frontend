{
  "law": {
    "id": "20230002",
    "parentId": "00000000",
    "rank": 8,
    "name": "도로교통법",
    "issue": "구간 교통안전시설 점검",
    "summary": "인천공항공사는 내년 초까지 인천공항 관리도로 150㎞ 구간의 교통안전시설 점검을 통해 종합적인 개선안을 마련할 계획입니다. 점검 대상은 인천공항 진·출입로와 인근 도로에 설치된 신호기, 안전표지, 노면표시 등입니다. 또한 2023년 이후 발생한 교통사고 자료를 분석해 사고 위험이 높은 구간을 선별하고, 시설 미비와 위험 요인을 진단한 뒤 단기·중장기 개선 방안을 마련해 순차적으로 시행할 방침입니다.",
    "updated": "2026-10-05",
    "sourceUrl": "https://argos.nanet.go.kr/main/fusionanalysis/lawIssueGuest.do?lawKwdId=20230002&lawKwdPid=00000000&titleNm=%EB%8F%84%EB%A1%9C%EA%B5%90%ED%86%B5%EB%B2%95"
  },
